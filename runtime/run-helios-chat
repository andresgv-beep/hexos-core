#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    echo "Uso: $0 /ruta/al/modelo.hnf [temperatura]" >&2
    echo "Opcional: HELIOS_CHAT_BIN=/ruta/a/helios_chat" >&2
    exit 2
fi

runtime_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
hexos_dir=$(dirname -- "$runtime_dir")
default_chat_bin="$hexos_dir/../Hector-engine/build/helios_chat"
chat_bin=${HELIOS_CHAT_BIN:-$default_chat_bin}

if [ ! -x "$chat_bin" ]; then
    echo "ERROR: no se encontró un helios_chat ejecutable en: $chat_bin" >&2
    echo "Compila Hector-engine o define HELIOS_CHAT_BIN=/ruta/a/helios_chat" >&2
    exit 127
fi

# El usuario puede fijar HELIOS_EMBED_MMAP=0 para comparar o diagnosticar.
# Si no lo especifica, HEXOS usa el modo verificado que mapea los embeddings
# desde el HNF y evita mantener su copia completa en RAM.
: "${HELIOS_EMBED_MMAP:=1}"
export HELIOS_EMBED_MMAP

# La visión tiene requisitos más estrictos que los embeddings. HEXOS consulta
# al driver los dos atributos que exige Héctor y resuelve auto a 0/1 antes de
# lanzar el proceso. Un override explícito del usuario sigue mandando.
runtime_probe="$hexos_dir/hexos/bin/hexos_runtime_probe"
if [ -x "$runtime_probe" ]; then
    HELIOS_VISION_MMAP=$($runtime_probe vision-mmap persistent)
    HELIOS_MMAP_DOUBLE_BUFFER=$($runtime_probe mmap-double-buffer persistent)
elif [ -z "${HELIOS_VISION_MMAP+x}" ] || [ "$HELIOS_VISION_MMAP" = "auto" ]; then
    echo "[hexos] aviso: falta hexos_runtime_probe; visión mmap desactivada" >&2
    echo "[hexos] ejecuta: make -C hexos runtime-probe" >&2
    HELIOS_VISION_MMAP=0
fi
if [ ! -x "$runtime_probe" ] && \
   { [ -z "${HELIOS_MMAP_DOUBLE_BUFFER+x}" ] || \
     [ "$HELIOS_MMAP_DOUBLE_BUFFER" = "auto" ]; }; then
    HELIOS_MMAP_DOUBLE_BUFFER=0
fi
export HELIOS_VISION_MMAP
export HELIOS_MMAP_DOUBLE_BUFFER

exec "$chat_bin" "$@"
