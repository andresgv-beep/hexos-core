[Unit]
Description=HEXOS puerta: nginx que solo deja pasar con sesión
Wants=hexos-puerta.service
After=hexos-puerta.service hexos-interfaz.service

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/.local/state/hexos/puerta/logs %h/.local/state/hexos/puerta/tmp
ExecStartPre=/usr/sbin/nginx -t -q -p %h/.local/state/hexos/puerta/ -e logs/error.log -c @REPO@/runtime/puerta/nginx.conf
ExecStart=/usr/sbin/nginx -p %h/.local/state/hexos/puerta/ -e logs/error.log -c @REPO@/runtime/puerta/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
