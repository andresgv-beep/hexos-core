# Build artifacts
bin/
obj/
*.o
*.a

# Runtime data (memoria, identidad, logs — datos vivos, nunca al repo)
runtime/memory/
runtime/hnf/
runtime/lora/
runtime/logs/
runtime/workspace/

# Archivos de identidad/memoria de prueba
*.hnf-ext
*.tmp

# Profiling
*.nsys-rep
*.sqlite

# Python
__pycache__/
*.pyc

# Interfaz web (Next.js): dependencias y artefactos generados, nunca al repo
interfaz/node_modules/
interfaz/.next/
interfaz/.vinext/
interfaz/.wrangler/
interfaz/dist/
interfaz/out/
interfaz/build/client/
interfaz/build/server/
interfaz/outputs/
interfaz/backups/
interfaz/coverage/
interfaz/*.tsbuildinfo
interfaz/.env
interfaz/.env.*
!interfaz/.env.example
interfaz/.vercel/
interfaz/.turbo/
